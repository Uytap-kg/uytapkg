# ==============================================================================
# UyTap Frontend - Пример переменных окружения (.env.example)
# ==============================================================================

# URL бэкенд API для браузерных (клиентских) запросов Next.js
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# Внутренний или публичный URL бэкенда для server-side proxy роутов Next.js
BACKEND_API_URL=https://your-backend.onrender.com/api

# Секрет для авторизации доверенного прокси (должен совпадать со значением на бэкенде)
INTERNAL_PROXY_SECRET=your-internal-proxy-secret-at-least-32-chars

# Адрес Supabase (используется для remotePatterns изображений в next.config.mjs)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Распознавание речи ElevenLabs (Speech-to-Text API)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Опционально: если приложение работает за Cloudflare (активирует cf-connecting-ip)
ENABLE_CLOUDFLARE=false

# Опционально: явный хост и порт для Next Image Optimization
# SUPABASE_HOSTNAME=your-project.supabase.co
# SUPABASE_PROTOCOL=https
# SUPABASE_PORT=443
