# ==============================================================================
# UyTap Frontend - Пример переменных окружения (.env.example)
# ==============================================================================

# URL бэкенд API для клиентских и серверных запросов Next.js
NEXT_PUBLIC_API_URL=http://localhost:5000/api
BACKEND_API_URL=http://localhost:5000/api

# Адрес Supabase (используется для настройки images.remotePatterns в next.config.mjs):
# Примеры:
#   - Self-hosted: http://IP_VPS:8000
#   - Cloud:       https://your-project-id.supabase.co
SUPABASE_URL=http://IP_VPS:8000

# Опционально: явный хост и порт для Next Image Optimization, если отличается от URL выше
# SUPABASE_HOSTNAME=IP_VPS
# SUPABASE_PROTOCOL=http
# SUPABASE_PORT=8000
