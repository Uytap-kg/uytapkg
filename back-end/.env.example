# ==============================================================================
# UyTap Backend - Пример переменных окружения (.env.example)
# ВНИМАНИЕ: Не вставляйте реальные секреты и пароли в этот файл!
# ==============================================================================

# Режим окружения (development / production)
NODE_ENV=production

# Порт бэкенд-сервера Express (Render автоматически задаёт PORT)
PORT=5000

# Разрешённые CORS-источники через запятую (фронтенд-домены)
ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://uytap.kg

# Секрет для авторизации доверенного прокси Next.js (обязателен в production, >= 16 символов)
INTERNAL_PROXY_SECRET=your-internal-proxy-secret-at-least-32-chars

# ==============================================================================
# ВАЖНО: Разница между SUPABASE_URL и DATABASE_URL
# ==============================================================================
# SUPABASE_URL:
#   Адрес REST API Supabase / PostgREST (Kong API Gateway).
#   Используется кодом приложения через @supabase/supabase-js SDK.
#   Примеры:
#     - Self-hosted VPS: http://IP_VPS:8000
#     - Supabase Cloud:  https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_KEY:
#   Ключ service_role для полного административного доступа бэкенда к БД и Storage.
#   Бэкенд обходит RLS (RLS bypass) благодаря этому ключу.
SUPABASE_KEY=your-service-role-key-here

# DATABASE_URL:
#   Строка прямого подключения к PostgreSQL (порт 5432 или 6543 с пулером).
#   Используется для прямого пула соединений pg и применения миграций (supabase db push).
#   Примеры:
#     - Self-hosted VPS: postgresql://postgres:your-postgres-password@IP_VPS:5432/postgres
#     - Supabase Cloud:  postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-postgres-password@db.your-project-id.supabase.co:5432/postgres

# ==============================================================================
# Авторизация и безопасность (JWT & OTP)
# ==============================================================================
JWT_SECRET=your-jwt-secret-key-at-least-32-chars
OTP_SECRET=your-otp-secret-key-at-least-32-chars

# ==============================================================================
# Внешние интеграции
# ==============================================================================
# AI Configuration (Claude Haiku 5.5 / Gemini)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
# Опционально: если ключ не привязан к конкретному воркспейсу (Organization Key):
# ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id
# Опционально: если используется прокси или OpenRouter (по умолчанию https://api.anthropic.com/v1):
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Резервный провайдер (Gemini AI API Key)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Платёжный шлюз O!Деньги
ODENGI_API_URL=https://api.odengi.kg
ODENGI_SID=your-odengi-sid
ODENGI_PASSWORD=your-odengi-password
ODENGI_VERSION=1005
ODENGI_TEST=1
ODENGI_RESULT_URL=https://your-backend.onrender.com/api/payments/odengi/callback

# SMS-сервис Nikita OTP (smspro.nikita.kg)
# API-ключ генерируется в личном кабинете: вкладка «СЕРВИС OTP»
NIKITA_API_KEY=your-nikita-api-key
# Базовый URL API (по умолчанию https://smspro.nikita.kg)
NIKITA_BASE_URL=https://smspro.nikita.kg
# Таймаут запроса в миллисекундах (по умолчанию 10000)
NIKITA_TIMEOUT_MS=10000
# Кулдаун повторной отправки на один номер в секундах (по умолчанию 60)
NIKITA_RESEND_COOLDOWN_SEC=60
# Лимит отправок на один номер в час (по умолчанию 5)
NIKITA_HOURLY_LIMIT_PHONE=5
# Лимит отправок с одного IP в час (по умолчанию 120)
NIKITA_HOURLY_LIMIT_IP=120
# Дневной лимит SMS на весь сервис (по умолчанию 500)
NIKITA_DAILY_SERVICE_CEILING=500

# Отправка email (Resend API или SMTP)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=UyTap <onboarding@resend.dev>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ==============================================================================
# Мониторинг и оповещения (Telegram Alerts)
# ==============================================================================
# Токен бота Telegram (от @BotFather) для отправки критических алертов
ALERT_TELEGRAM_BOT_TOKEN=
# ID чата или группы Telegram, куда будут приходить уведомления об ошибках
ALERT_TELEGRAM_CHAT_ID=
