# ==============================================================================
# UyTap Monorepo - Сводный пример переменных окружения (.env.example)
# ==============================================================================
# ВНИМАНИЕ: Не вставляйте реальные секреты в этот файл!
# Заполните переменные в ваших локальных .env или настройках Render / Vercel.

# ------------------------------------------------------------------------------
# 1. База данных и Supabase
# ------------------------------------------------------------------------------
# SUPABASE_URL:
#   REST API адрес Supabase / Kong (порт 8000 для self-hosted или cloud URL).
#   Используется кодом бэкенда (back-end/src/config/db.js) через @supabase/supabase-js.
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_KEY:
#   Секретный service_role ключ бэкенда для выполнения административных операций и обхода RLS.
SUPABASE_KEY=your-supabase-service-role-key

# DATABASE_URL:
#   Строка прямого подключения к PostgreSQL (порт 5432 или 6543 с пулером).
#   Используется для прямого пула соединений pg и для накатки миграций Supabase CLI.
DATABASE_URL=postgresql://postgres:your-postgres-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Бэкенд (back-end)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Разрешённые CORS-источники (через запятую). Обязательно укажите URL фронтенда на Render/Vercel
ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://uytap.kg

# Секрет для авторизации прокси между Next.js фронтендом и Express бэкендом (минимум 16-32 символа)
INTERNAL_PROXY_SECRET=your-internal-proxy-secret-at-least-32-chars

# JWT и OTP безопасность
JWT_SECRET=your-jwt-secret-key-at-least-32-chars
OTP_SECRET=your-otp-secret-key-at-least-32-chars

# Искусственный интеллект (Smart Search & Описание объектов)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id

# Резервный AI-провайдер (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Платёжная система O!Деньги (QR Pay API)
ODENGI_API_URL=https://api.odengi.kg
ODENGI_SID=your-odengi-sid
ODENGI_PASSWORD=your-odengi-password
ODENGI_VERSION=1005
ODENGI_TEST=1
ODENGI_RESULT_URL=https://your-backend.onrender.com/api/payments/odengi/callback

# SMS-сервис Nikita OTP (smspro.nikita.kg)
NIKITA_API_KEY=your-nikita-api-key
NIKITA_BASE_URL=https://smspro.nikita.kg
NIKITA_TIMEOUT_MS=10000
NIKITA_RESEND_COOLDOWN_SEC=60
NIKITA_HOURLY_LIMIT_PHONE=5
NIKITA_HOURLY_LIMIT_IP=120
NIKITA_DAILY_SERVICE_CEILING=500

# Отправка email (Resend API или SMTP)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=UyTap <onboarding@resend.dev>
# Альтернатива SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=UyTap <no-reply@uytap.kg>

# Мониторинг и оповещения (Telegram Alerts)
ALERT_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ALERT_TELEGRAM_CHAT_ID=your-telegram-chat-id

# ------------------------------------------------------------------------------
# 3. Фронтенд (front-end)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
BACKEND_API_URL=https://your-backend.onrender.com/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Распознавание речи ElevenLabs (Speech-to-Text)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Опционально: включение заголовка cf-connecting-ip при работе за Cloudflare
ENABLE_CLOUDFLARE=false
