# ==============================================================================
# UyTap Monorepo - Сводный пример переменных окружения (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. База данных и Supabase
# ------------------------------------------------------------------------------
# ВАЖНОЕ РАЗЛИЧИЕ:
#
# SUPABASE_URL:
#   REST API адрес Supabase / Kong (порт 8000).
#   Используется кодом приложения (back-end/src/config/db.js) через @supabase/supabase-js.
#   Формат: http://IP_VPS:8000 или https://your-project.supabase.co
SUPABASE_URL=http://IP_VPS:8000

# SUPABASE_KEY:
#   Секретный service_role ключ бэкенда для выполнения административных операций и обхода RLS.
SUPABASE_KEY=your-service-role-key-here

# DATABASE_URL:
#   Строка прямого подключения к PostgreSQL (порт 5432).
#   Используется ИСКЛЮЧИТЕЛЬНО для CLI миграций: npx supabase db push --db-url "$DATABASE_URL"
#   Формат: postgresql://postgres:your-postgres-password@IP_VPS:5432/postgres
DATABASE_URL=postgresql://postgres:your-postgres-password@IP_VPS:5432/postgres

# ------------------------------------------------------------------------------
# 2. Бэкенд (back-end)
# ------------------------------------------------------------------------------
PORT=5000
JWT_SECRET=your-jwt-secret-key-at-least-32-chars
GEMINI_API_KEY=your-gemini-api-key

# Платёжная система Odengi
ODENGI_API_URL=https://api.odengi.kg
ODENGI_SID=your-odengi-sid
ODENGI_PASSWORD=your-odengi-password
ODENGI_VERSION=1.0
ODENGI_TEST=1
ODENGI_RESULT_URL=http://localhost:5000/api/payments/odengi/callback

# SMS-сервис Nikita OTP (smspro.nikita.kg)
NIKITA_API_KEY=your-nikita-api-key
NIKITA_BASE_URL=https://smspro.nikita.kg
NIKITA_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. Фронтенд (front-end)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
BACKEND_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SUPABASE_URL=http://IP_VPS:8000
